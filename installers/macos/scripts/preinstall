#!/bin/sh
# Celluloid Pro: remove a previous installation so no stale files survive an upgrade.
# $3 = target volume ("/" for the boot volume).
TARGET="${3:-/}"
PLUGIN="${TARGET%/}/Library/OFX/Plugins/Celluloid.ofx.bundle"
if [ -d "$PLUGIN" ]; then
  /bin/rm -rf "$PLUGIN"
fi
/bin/mkdir -p "${TARGET%/}/Library/OFX/Plugins"
exit 0
