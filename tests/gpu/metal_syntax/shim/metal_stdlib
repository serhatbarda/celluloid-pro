float clamp(float, float, float);
float mix(float, float, float);
float step(float, float);
float sign(float);
bool isfinite(float);
bool isnan(float);
bool isinf(float);
int min(int, int);
int max(int, int);
uint min(uint, uint);
uint max(uint, uint);
