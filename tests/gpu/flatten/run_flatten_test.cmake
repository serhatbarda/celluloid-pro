# Celluloid Pro - test of cmake/FlattenKernels.cmake. Run: cmake -DREPO=<repo> -DOUT=<dir> -P run_flatten_test.cmake
set(script "${REPO}/cmake/FlattenKernels.cmake")
set(fx "${REPO}/tests/gpu/flatten")
file(MAKE_DIRECTORY "${OUT}")
set(failures 0)
cmake_policy(SET CMP0007 NEW)
cmake_policy(SET CMP0057 NEW)
# expect(<message> <if-condition...>)
macro(expect msg)
  if(${ARGN})
    message(STATUS "ok   ${msg}")
  else()
    message(SEND_ERROR "FAIL ${msg}")
    math(EXPR failures "${failures}+1")
  endif()
endmacro()
function(count_of text needle out)
  string(REGEX MATCHALL "${needle}" m "${text}")
  list(LENGTH m n)
  set(${out} ${n} PARENT_SCOPE)
endfunction()

execute_process(COMMAND "${CMAKE_COMMAND}" -DCEL_ROOT_FILE=${fx}/fixture/root.h -DCEL_SYMBOL=fixture
  -DCEL_OUTPUT_CPP=${OUT}/fixture.cpp -DCEL_OUTPUT_FLAT=${OUT}/fixture.flat -DCEL_BASE_DIR=${fx}
  -DCEL_INCLUDE_DIRS=${fx}/incdir -P "${script}" RESULT_VARIABLE rc ERROR_VARIABLE er)
expect("fixture flattens (${er})" rc EQUAL 0)
file(READ "${OUT}/fixture.flat" flat)
count_of("${flat}" "int marker_a" na)
expect("guarded header inlined once (got ${na})" na EQUAL 1)
count_of("${flat}" "ITEM\\(x\\)" nx)
expect("unguarded X-macro list inlined at every include (got ${nx})" nx EQUAL 2)
count_of("${flat}" "int marker_b" nb)
expect("nested relative include" nb EQUAL 1)
count_of("${flat}" "int marker_c" nc)
expect("include resolved through INCLUDE_DIRS" nc EQUAL 1)
count_of("${flat}" "int marker_once" no)
expect("#pragma once honoured (got ${no})" no EQUAL 1)
string(FIND "${flat}" "does_not_exist.h" dn)
expect("mid-line include text left untouched" NOT dn EQUAL -1)
string(FIND "${flat}" "#line 1 \"fixture/sub/b.h\"" lb)
expect("#line markers use BASE_DIR-relative paths" NOT lb EQUAL -1)
string(FIND "${flat}" "${REPO}" leak)
expect("no absolute build paths in the flattened source" leak EQUAL -1)
string(REGEX MATCH "#line ([0-9]+) \"fixture/root.h\"\n#include|#line ([0-9]+) \"fixture/root.h\"\nint root_end" lm "${flat}")
expect("line numbers resume correctly after an include (got '${CMAKE_MATCH_2}')" CMAKE_MATCH_2 EQUAL 13)
# the generated C++ contains the exact bytes
file(READ "${OUT}/fixture.cpp" cpp)
string(LENGTH "${flat}" flen)
string(FIND "${cpp}" "fixture_len = ${flen};" fl)
expect("embedded length matches" NOT fl EQUAL -1)
# the byte array in the generated C++ equals the flattened file (pure CMake, every platform)
file(READ "${OUT}/fixture.flat" flathex HEX)
string(REGEX MATCHALL "0x[0-9a-f][0-9a-f]" cppbytes "${cpp}")
list(POP_BACK cppbytes cppterm)
string(REPLACE ";" "" cpphex "${cppbytes}")
string(REPLACE "0x" "" cpphex "${cpphex}")
expect("embedded byte array equals the flattened file" cpphex STREQUAL flathex AND cppterm STREQUAL "0x00")
# compile + run check with a GCC/Clang-style compiler (Unix hosts; on Windows runners a stray
# MinGW c++ on PATH may produce executables that cannot start)
if(NOT CMAKE_HOST_WIN32)
  find_program(CXX NAMES c++ g++ clang++)
endif()
if(CXX)
  file(WRITE "${OUT}/main.cpp" "#include <cstdio>\n#include <cstring>\n#include <cstddef>\nnamespace cel{namespace gpu{namespace embedded{extern const char fixture[];extern const std::size_t fixture_len;}}}\nint main(int,char**v){FILE*f=std::fopen(v[1],\"rb\");static char b[1<<20];size_t n=std::fread(b,1,sizeof b,f);std::fclose(f);return (n==cel::gpu::embedded::fixture_len&&std::memcmp(b,cel::gpu::embedded::fixture,n)==0&&cel::gpu::embedded::fixture[n]==0)?0:1;}\n")
  execute_process(COMMAND "${CXX}" -std=c++17 "${OUT}/main.cpp" "${OUT}/fixture.cpp" -o "${OUT}/embedcheck" RESULT_VARIABLE crc)
  expect("generated C++ compiles" crc EQUAL 0)
  execute_process(COMMAND "${OUT}/embedcheck" "${OUT}/fixture.flat" RESULT_VARIABLE erc)
  expect("embedded bytes identical to the flattened file" erc EQUAL 0)
endif()
# unchanged inputs do not rewrite outputs (no needless rebuilds)
file(TIMESTAMP "${OUT}/fixture.cpp" t1 "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
execute_process(COMMAND "${CMAKE_COMMAND}" -DCEL_ROOT_FILE=${fx}/fixture/root.h -DCEL_SYMBOL=fixture
  -DCEL_OUTPUT_CPP=${OUT}/fixture.cpp -DCEL_OUTPUT_FLAT=${OUT}/fixture.flat -DCEL_BASE_DIR=${fx}
  -DCEL_INCLUDE_DIRS=${fx}/incdir -P "${script}" RESULT_VARIABLE rc)
file(TIMESTAMP "${OUT}/fixture.cpp" t2 "%s")
expect("outputs only rewritten on change" t1 STREQUAL t2)
# errors
foreach(case missing cycle1 collision)
  execute_process(COMMAND "${CMAKE_COMMAND}" -DCEL_ROOT_FILE=${fx}/bad/${case}.h -DCEL_SYMBOL=bad
    -DCEL_OUTPUT_CPP=${OUT}/bad.cpp -DCEL_OUTPUT_FLAT=${OUT}/bad.flat -P "${script}"
    RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE er)
  expect("${case}: fails loudly" NOT rc EQUAL 0)
endforeach()
if(failures GREATER 0)
  message(FATAL_ERROR "${failures} flattener check(s) failed")
endif()
message(STATUS "flattener: all checks passed")
